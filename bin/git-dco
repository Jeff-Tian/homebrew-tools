#!/usr/bin/env bash
# git-dco — one-shot DCO sign-off hook installer
#
# Usage:
#   git dco init            Install into the active hooks directory (local)
#                           without changing core.hooksPath or other hooks
#   git dco init --global   Install to ~/.githooks and set core.hooksPath globally
#   git dco check           Diagnose current configuration
#   git dco uninstall       Restore the original hook; keep hooksPath unchanged
#   git dco --version       Print version
#
# The installed hook auto-appends a Signed-off-by trailer to every commit
# message, so GitHub's DCO check passes without remembering `git commit -s`.

set -euo pipefail

VERSION="0.1.1"

HOOK_BODY='#!/bin/sh
# Auto sign-off for DCO (installed by `git dco`)
original="$(dirname "$0")/prepare-commit-msg.git-dco-original"
if [ -x "$original" ]; then
  "$original" "$@" || exit $?
fi
COMMIT_MSG_FILE=$1
COMMIT_SOURCE=${2:-}
[ "$COMMIT_SOURCE" = "merge" ] && exit 0
grep -q "^Signed-off-by:" "$COMMIT_MSG_FILE" && exit 0
SOB=$(git var GIT_COMMITTER_IDENT | sed -n "s/^\(.*>\).*$/Signed-off-by: \1/p")
printf "\n%s\n" "$SOB" >> "$COMMIT_MSG_FILE"
'

usage() {
  sed -n '3,16p' "$0" | sed 's/^# \{0,1\}//'
}

is_dco_hook() {
  [ -f "$1" ] && [ "$(cat "$1")" = "$(printf '%s' "$HOOK_BODY")" ]
}

is_legacy_hook() {
  [ -f "$1" ] && [ "$(cat "$1")" = "$(printf '%s' "$HOOK_BODY" | sed '/^original=/,/^fi$/d')" ]
}

validate_hook() {
  local path=$1 backup="$1.git-dco-original"
  if [ -L "$path" ] || [ -L "$backup" ] ||
     { [ -e "$path" ] && [ ! -f "$path" ]; } ||
     { [ -e "$backup" ] && [ ! -f "$backup" ]; }; then
    echo "Refusing unsupported hook path: $path" >&2
    exit 1
  fi
}

write_hook() {
  local dir=$1 path="$1/prepare-commit-msg"
  validate_hook "$path"
  if is_dco_hook "$path"; then chmod +x "$path"; return; fi
  if [ -e "$path.git-dco-original" ] ||
     { [ -f "$path" ] && grep -q '^# Auto sign-off for DCO' "$path" && ! is_legacy_hook "$path"; }; then
    echo "Refusing to overwrite edited DCO hook or existing backup: $path" >&2
    exit 1
  fi
  mkdir -p "$dir"
  if [ -f "$path" ] && ! is_legacy_hook "$path"; then
    mv "$path" "$path.git-dco-original"
  fi
  printf '%s' "$HOOK_BODY" > "$path"
  chmod +x "$path"
}

repo_hooks_directory() {
  git rev-parse --show-toplevel >/dev/null 2>&1 || {
    echo "✗ Not inside a git repository." >&2
    exit 1
  }
  if ! git config --local --get core.hooksPath >/dev/null &&
     ! git config --worktree --get core.hooksPath >/dev/null &&
     git config --get core.hooksPath >/dev/null; then
    echo "Inherited core.hooksPath: refusing to modify shared hooks. Use init --global or configure a repository-local hooks directory." >&2
    exit 1
  fi
  git rev-parse --git-path hooks
}

install_repo() {
  local dir
  dir=$(repo_hooks_directory)
  write_hook "$dir"
  echo "✓ Installed $dir/prepare-commit-msg (core.hooksPath unchanged)"
  echo
  echo "Next: commit normally — Signed-off-by trailer will be appended automatically."
}

install_global() {
  local dir
  dir=$(git config --global core.hooksPath || echo "$HOME/.githooks")
  if [ -z "$dir" ]; then echo "Empty global hooksPath." >&2; exit 1; fi
  case "$dir" in
    /*) ;;
    *) echo "Relative global hooksPath: choose an absolute path before global installation." >&2; exit 1 ;;
  esac
  write_hook "$dir"
  git config --global core.hooksPath "$dir"
  echo "✓ Installed $dir/prepare-commit-msg"
  echo "✓ Set core.hooksPath = $dir (global)"
}

check() {
  echo "git-dco version : $VERSION"
  echo "user.name       : $(git config user.name || echo '(unset)')"
  echo "user.email      : $(git config user.email || echo '(unset)')"
  echo "global hooksPath: $(git config --global core.hooksPath || echo '(unset)')"
  if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    local root
    root=$(git rev-parse --show-toplevel)
    echo "repo root       : $root"
    echo "local hooksPath : $(git -C "$root" config --local core.hooksPath || echo '(unset)')"
    local hp
    hp=$(git rev-parse --git-path hooks)
    if { is_dco_hook "$hp/prepare-commit-msg" || is_legacy_hook "$hp/prepare-commit-msg"; } &&
       [ -x "$hp/prepare-commit-msg" ]; then
      echo "✓ DCO prepare-commit-msg found at $hp"
    else
      echo "✗ No unmodified executable DCO hook in $hp"
    fi
  else
    echo "(not inside a git repository — skipping repo-level checks)"
  fi
}

uninstall_repo() {
  local dir path backup
  dir=$(repo_hooks_directory)
  path="$dir/prepare-commit-msg"
  backup="$path.git-dco-original"
  validate_hook "$path"
  if is_dco_hook "$path" || is_legacy_hook "$path"; then
    rm "$path"
    if [ -f "$backup" ]; then mv "$backup" "$path"; fi
  elif [ -e "$path" ] || [ -e "$backup" ]; then
    echo "Refusing to remove edited or unowned hook: $path" >&2
    exit 1
  fi
  echo "✓ Removed DCO wrapper (core.hooksPath and other hooks unchanged)"
}

cmd=${1:-}
if [ "$#" -gt 1 ] && ! { [ "$#" = 2 ] && [ "$cmd" = init ] && [ "$2" = --global ]; }; then
  usage >&2
  exit 2
fi
case "$cmd" in
  init)
    shift
    if [ "${1:-}" = "--global" ]; then
      install_global
    else
      install_repo
    fi
    ;;
  check)   check ;;
  uninstall) uninstall_repo ;;
  -v|--version) echo "git-dco $VERSION" ;;
  -h|--help|"") usage ;;
  *)
    echo "Unknown command: $cmd" >&2
    usage >&2
    exit 2
    ;;
esac
