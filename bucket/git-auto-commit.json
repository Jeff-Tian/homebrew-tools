{
  "version": "0.2.8",
  "description": "Generate Conventional/Angular commit messages with gitmoji emoji from staged diff via AI",
  "homepage": "https://github.com/Jeff-Tian/homebrew-tools",
  "license": "MIT",
  "depends": [
    "git"
  ],
  "url": [
    "https://raw.githubusercontent.com/Jeff-Tian/homebrew-tools/main/bin/git-auto-commit#/git-auto-commit",
    "https://raw.githubusercontent.com/Jeff-Tian/homebrew-tools/main/bin/git-auto-commit.cmd#/git-auto-commit.cmd",
    "https://raw.githubusercontent.com/Jeff-Tian/homebrew-tools/main/bin/gitmojis.txt#/gitmojis.txt"
  ],
  "hash": [
    "skip",
    "skip",
    "skip"
  ],
  "bin": [
    [
      "git-auto-commit.cmd",
      "git-auto-commit"
    ]
  ],
  "suggest": {
    "GitHub Copilot CLI": "copilot"
  },
  "checkver": {
    "url": "https://raw.githubusercontent.com/Jeff-Tian/homebrew-tools/main/bin/git-auto-commit",
    "regex": "VERSION=\"([0-9.]+)\""
  },
  "autoupdate": {
    "url": [
      "https://raw.githubusercontent.com/Jeff-Tian/homebrew-tools/main/bin/git-auto-commit#/git-auto-commit",
      "https://raw.githubusercontent.com/Jeff-Tian/homebrew-tools/main/bin/git-auto-commit.cmd#/git-auto-commit.cmd",
      "https://raw.githubusercontent.com/Jeff-Tian/homebrew-tools/main/bin/gitmojis.txt#/gitmojis.txt"
    ],
    "hash": [
      "skip",
      "skip",
      "skip"
    ]
  }
}
